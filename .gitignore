```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled and build artifacts
*.o
*.obj
*.out
*.so
*.dll
*.a
*.class

# Dependencies
.venv/
venv/
node_modules/
dist/
build/
.mypy_cache/
.pytest_cache/
.coverage
coverage/
htmlcov/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment files
.env
.env.local
*.env.*

# Editors and IDE
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db
```