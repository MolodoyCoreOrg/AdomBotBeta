```gitignore
# Python compiled files
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Dependencies
.venv/
venv/
node_modules/

# Coverage reports
.coverage
coverage/
htmlcov/

# Distribution artifacts
dist/
build/
target/

# Testing cache
.pytest_cache/
.mypy_cache/
```